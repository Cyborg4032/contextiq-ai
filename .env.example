# Copy this file to .env for local dev.
# On Render, set these as environment variables in the dashboard instead —
# do not commit a real .env file.

GROQ_API_KEY=your_groq_api_key_here          # Groq Whisper STT (English)
MISTRAL_API_KEY=your_mistral_api_key_here    # Summaries, extraction, RAG chat
SARVAM_API_KEY=your_sarvam_api_key_here      # Sarvam STT (Hinglish)

# Optional — only needed if YouTube URL downloads get blocked with
# "Sign in to confirm you're not a bot":
# YTDLP_COOKIES_BROWSER=chrome    # local dev: reads cookies from this browser
# YTDLP_COOKIES_FILE=cookies.txt  # server/Render: path to an exported cookies file
